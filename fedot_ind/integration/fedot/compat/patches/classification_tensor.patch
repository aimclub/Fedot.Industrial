@@ -0,0 +1,47 @@
+from dataclasses import replace
+
+import fedot
+import numpy as np
+import pytest
+import torch
+from sklearn.linear_model import LogisticRegression
+from sklearn.tree import DecisionTreeClassifier
+
+from fedot.core.operations.evaluation.classification import SkLearnClassificationStrategy
+from fedot.core.operations.operation_parameters import OperationParameters
+from fedot.core.pipelines.pipeline_builder import PipelineBuilder
+
+
+@pytest.mark.parametrize('classes', [2, 3])
+@pytest.mark.parametrize('operation,model', [('logit', LogisticRegression), ('dt', DecisionTreeClassifier)])
+@pytest.mark.parametrize('output_mode', ['labels', 'full_probs'])
+def test_native_classifiers_preserve_tensor_contract_and_match_sklearn(classes, operation, model, output_mode):
+    x = np.random.default_rng(11).normal(size=(60, 4)).astype('float32')
+    y = np.arange(60) % classes
+    data = fedot.create_data(x, target=y, task='classification')
+    features_before, target_before = data.features.clone(), data.target.clone()
+    pipeline = PipelineBuilder().add_node(operation, params={'random_state': 7}).build()
+    pipeline.fit(data)
+    prediction_input = replace(data, target=None, state='predict')
+    output = pipeline.predict(prediction_input, output_mode=output_mode)
+    reference = model(random_state=7).fit(x, y)
+    expected = reference.predict(x) if output_mode == 'labels' else reference.predict_proba(x)
+    np.testing.assert_allclose(output.predict.detach().numpy().squeeze(), expected, rtol=1e-5, atol=1e-6)
+    assert output.idx.tolist() == data.idx.tolist()
+    assert output.task == data.task
+    assert output.predict.device == data.device
+    assert output.target is None
+    torch.testing.assert_close(data.features, features_before)
+    torch.testing.assert_close(data.target, target_before)
+
+
+def test_legacy_input_still_uses_legacy_output_packaging(monkeypatch):
+    strategy = SkLearnClassificationStrategy('dt', OperationParameters())
+    strategy.output_mode = 'labels'
+    x = np.array([[0.], [1.], [2.], [3.]])
+    fitted = DecisionTreeClassifier().fit(x, [0, 0, 1, 1])
+    from types import SimpleNamespace
+    incoming = SimpleNamespace(features=x)
+    expected = object()
+    monkeypatch.setattr(strategy, '_convert_to_output', lambda prediction, data: expected)
+    assert strategy.predict(fitted, incoming) is expected
