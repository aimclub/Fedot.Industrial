diff --git a/test/unit/operations/test_evo04_prediction_cache_identity.py b/test/unit/operations/test_evo04_prediction_cache_identity.py
new file mode 100644
index 00000000..6ec81cda
--- /dev/null
+++ b/test/unit/operations/test_evo04_prediction_cache_identity.py
@@ -0,0 +1,36 @@
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from fedot.core.operations.operation import Operation
+
+
+def operation():
+    value = object.__new__(Operation)
+    value._init = Mock()
+    value._eval_strategy = SimpleNamespace(fit=Mock(return_value='model'),
+                                           predict_for_fit=Mock(return_value='output'))
+    return value
+
+
+def test_fit_forwards_node_identity_to_prediction_cache():
+    value = operation()
+    cache = Mock()
+    cache.load_node_prediction.return_value = None
+    data = SimpleNamespace(task='task', features=SimpleNamespace(shape=(4, 2)))
+    _, output = value.fit(None, data, cache, fold_id=2, descriptive_id='ridge/alpha=1')
+    assert output == 'output'
+    cache.load_node_prediction.assert_called_once_with('ridge/alpha=1', 'default', 2, is_fit=True)
+    cache.save_node_prediction.assert_called_once_with('ridge/alpha=1', 'default', 2, 'output', is_fit=True)
+
+
+@pytest.mark.parametrize('identity', [None, ''])
+def test_missing_identity_skips_cache_instead_of_sharing_none_key(identity):
+    value = operation()
+    cache = Mock()
+    data = SimpleNamespace(task='task', features=SimpleNamespace(shape=(4, 2)))
+    _, output = value.fit(None, data, cache, descriptive_id=identity)
+    assert output == 'output'
+    cache.load_node_prediction.assert_not_called()
+    cache.save_node_prediction.assert_not_called()
