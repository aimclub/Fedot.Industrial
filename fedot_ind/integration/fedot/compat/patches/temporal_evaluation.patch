@@ -0,0 +1,111 @@
+from dataclasses import replace
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from fedot.core.data.tensor_data import TensorData
+from fedot.core.operations.evaluation.temporal_extensions import (
+    apply_temporal_transform, is_temporal_window_transform, temporal_transform_request,
+)
+from fedot.core.repository.dataset_types import DataTypesEnum
+from fedot.core.repository.tasks import Task, TaskTypesEnum, TsForecastingParams
+from fedot.extensions.contracts import ArrayBackend, ExtensionContractError
+from fedot.extensions.runtime_contracts import TemporalTransformOutput, TransformInput
+from fedot.extensions.runtime_rules import transform_features
+
+
+def _data():
+    return TensorData(task=Task(TaskTypesEnum.ts_forecasting, TsForecastingParams(3)),
+                      data_type=DataTypesEnum.ts, features=torch.arange(20.)[None, :],
+                      target=torch.full((1, 3), 999.), idx=np.array([0]),
+                      fingerprint='stale', trace_uuid='stale')
+
+
+def _spec(backend=ArrayBackend.numpy):
+    return SimpleNamespace(capabilities=SimpleNamespace(backend=backend, tags=('ts_to_table',)))
+
+
+def _output():
+    return TemporalTransformOutput(np.ones((2, 4)), np.ones((2, 3)), np.array([4, 5]))
+
+
+@pytest.mark.parametrize('backend', [ArrayBackend.numpy, ArrayBackend.torch])
+@pytest.mark.parametrize('fitting', [False, True])
+def test_request_contains_private_history_and_actual_horizon_only(backend, fitting):
+    data = _data()
+    request = temporal_transform_request(data, backend, fit_stage=fitting)
+    assert request.horizon == 3 and request.fit_stage is fitting
+    assert request.features.shape == (20,)
+    assert not hasattr(request, 'target')
+    request.features[0] = -1
+    assert data.features[0, 0].item() == 0
+
+
+def test_window_output_replaces_targets_indices_and_stale_metadata():
+    data = _data()
+    output = _output()
+    instance = SimpleNamespace(transform_temporal=lambda request: output)
+    result = apply_temporal_transform(_spec(), instance, data, fit_stage=True)
+    assert result.features.shape == (2, 4) and result.target.shape == (2, 3)
+    assert result.idx.tolist() == [4, 5]
+    assert result.data_type is DataTypesEnum.tabular
+    assert result.fingerprint is None and result.trace_uuid is None and result.preparation_state is None
+    result.features[0, 0] = -1
+    result.target[0, 0] = -1
+    result.idx[0] = -1
+    assert output.features[0, 0] == 1 and output.target[0, 0] == 1 and output.idx[0] == 4
+    assert data.features.shape == (1, 20) and data.target[0, 0] == 999
+
+
+@pytest.mark.parametrize('changes', [
+    {'features': np.zeros(2)}, {'features': np.zeros((0, 4))}, {'features': np.full((2, 4), np.nan)},
+    {'features': [1, 2]}, {'target': None}, {'target': np.ones((2, 20))},
+    {'target': np.full((2, 3), np.inf)}, {'idx': np.array([1])}, {'idx': np.array([1, 1])},
+    {'idx': np.ones((2, 1))}, {'idx': [1, 2]},
+])
+def test_malformed_temporal_outputs_are_rejected(changes):
+    instance = SimpleNamespace(transform_temporal=lambda request: replace(_output(), **changes))
+    with pytest.raises(ExtensionContractError, match='.') as error:
+        apply_temporal_transform(_spec(), instance, _data(), fit_stage=True)
+    assert error.value.code == 'invalid_temporal_transform_output'
+
+
+@pytest.mark.parametrize('output', [None, _output(), replace(_output(), target=None)])
+def test_inference_requires_one_window_without_target(output):
+    instance = SimpleNamespace(transform_temporal=lambda request: output)
+    with pytest.raises(ExtensionContractError):
+        apply_temporal_transform(_spec(), instance, _data(), fit_stage=False)
+
+
+def test_missing_temporal_method_is_not_silently_replaced_by_ordinary_transform():
+    with pytest.raises(ExtensionContractError) as error:
+        apply_temporal_transform(_spec(), SimpleNamespace(transform=lambda x: x), _data(), fit_stage=True)
+    assert error.value.code == 'missing_runtime_method'
+
+
+@pytest.mark.parametrize('shape', [(2, 20), (1, 2, 20)])
+def test_multiseries_or_multichannel_input_is_rejected_before_flattening(shape):
+    data = replace(_data(), features=torch.zeros(shape), target=None, idx=np.arange(shape[0]))
+    with pytest.raises(ValueError, match='one univariate'):
+        temporal_transform_request(data, ArrayBackend.numpy, fit_stage=True)
+
+
+@pytest.mark.parametrize('task, dtype, tags', [
+    (TaskTypesEnum.regression, DataTypesEnum.ts, ('ts_to_table',)),
+    (TaskTypesEnum.classification, DataTypesEnum.ts, ('ts_to_table',)),
+    (TaskTypesEnum.ts_forecasting, DataTypesEnum.tabular, ('ts_to_table',)),
+    (TaskTypesEnum.ts_forecasting, DataTypesEnum.ts, ()),
+])
+def test_temporal_path_requires_tag_task_and_raw_series_type(task, dtype, tags):
+    spec = SimpleNamespace(capabilities=SimpleNamespace(tags=tags))
+    data = SimpleNamespace(task=Task(task), data_type=dtype)
+    assert not is_temporal_window_transform(spec, data)
+
+
+def test_ordinary_transform_still_cannot_change_sample_count():
+    instance = SimpleNamespace(transform=lambda values: np.ones((2, 3)))
+    with pytest.raises(ExtensionContractError) as error:
+        transform_features(_spec(), instance, TransformInput(np.ones((1, 20))), {})
+    assert error.value.code == 'output_row_mismatch'
