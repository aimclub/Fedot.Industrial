@@ -0,0 +1,51 @@
+"""Temporal hold-out for prepared series; never slice the sample axis."""
+from dataclasses import dataclass, replace
+from numbers import Integral
+
+from fedot.core.data.common.enums import StateEnum
+from fedot.core.data.tensor_data import TensorData
+
+
+@dataclass(frozen=True)
+class TemporalHoldoutPlan:
+    context_steps: int
+    horizon: int
+
+
+def plan_temporal_holdout(shape, horizon, validation_blocks=None):
+    if len(shape) not in (2, 3) or any(size <= 0 for size in shape):
+        raise ValueError('Temporal hold-out requires (series, time) or (series, channels, time)')
+    for name, value in (('horizon', horizon), ('validation_blocks', validation_blocks)):
+        if value is not None and (isinstance(value, bool) or not isinstance(value, Integral) or value <= 0):
+            raise ValueError(f'{name} must be a positive integer')
+    if horizon is None:
+        raise ValueError('Temporal hold-out requires an explicit forecast horizon')
+    if validation_blocks not in (None, 1):
+        raise ValueError('Multi-block TensorData validation requires a rolling forecast evaluator')
+    context_steps = shape[-1] - horizon
+    if context_steps <= 0:
+        raise ValueError('Forecast horizon must leave non-empty training history')
+    return TemporalHoldoutPlan(context_steps, int(horizon))
+
+
+def forecast_horizon(data):
+    task_horizon = getattr(data.task.task_params, 'forecast_length', None)
+    data_horizon = data.ts_forecast_horizon
+    if task_horizon is not None and data_horizon is not None and task_horizon != data_horizon:
+        raise ValueError('Task and TensorData forecast horizons must agree')
+    horizon = task_horizon if task_horizon is not None else data_horizon
+    if isinstance(horizon, bool) or not isinstance(horizon, Integral) or horizon <= 0:
+        raise ValueError('Forecasting requires an explicit positive forecast horizon')
+    return int(horizon)
+
+
+def temporal_tensor_holdout(data: TensorData, validation_blocks=None):
+    horizon = forecast_horizon(data)
+    plan = plan_temporal_holdout(data.features.shape, horizon, validation_blocks)
+    history = data.features[..., :plan.context_steps]
+    future = data.features[..., plan.context_steps:]
+    common = dict(predict=None,
+                  ts_init_shape=tuple(history.shape), fingerprint=None, trace_uuid=None)
+    train = replace(data, **common, features=history.clone(), target=history.clone(), state=StateEnum.FIT)
+    test = replace(data, **common, features=history.clone(), target=future.clone(), state=StateEnum.PREDICT)
+    return train, test
