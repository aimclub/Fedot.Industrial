+from dataclasses import replace
+
+import numpy as np
+import pytest
+import torch
+
+from fedot import create_data
+from fedot.core.data.split.temporal import plan_temporal_holdout
+from fedot.core.optimisers.objective.data_source_splitter import DataSourceSplitter
+from fedot.core.pipelines.pipeline_builder import PipelineBuilder
+from fedot.core.operations.evaluation.temporal_bridge import legacy_temporal_input
+from fedot.core.pipelines.pipeline_advisor import PipelineChangeAdvisor
+from fedot.core.repository.tasks import Task, TaskTypesEnum
+from golem.core.optimisers.graph import OptNode
+
+
+@pytest.mark.parametrize('shape', [(1, 40), (3, 40), (2, 2, 40)])
+def test_holdout_preserves_sample_axis_and_never_exposes_future(shape):
+    values = np.arange(np.prod(shape), dtype=float).reshape(shape)
+    data = create_data(values, task='ts_forecasting', data_type='ts',
+                       ts_forecast_horizon=4, without_target=True)
+    snapshot = data.features.clone()
+    train, test = next(DataSourceSplitter().build(data)())
+    assert train.features.shape == (*shape[:-1], 36)
+    torch.testing.assert_close(train.features, snapshot[..., :-4])
+    torch.testing.assert_close(train.target, train.features)
+    torch.testing.assert_close(test.features, train.features)
+    torch.testing.assert_close(test.target, snapshot[..., -4:])
+    torch.testing.assert_close(data.features, snapshot)
+    train.features.add_(1000)
+    torch.testing.assert_close(test.features, snapshot[..., :-4])
+
+
+@pytest.mark.parametrize('horizon,blocks', [(True, None), (0, None), (40, None), (4, 2), (4, False)])
+def test_invalid_temporal_plans_are_explicit(horizon, blocks):
+    with pytest.raises(ValueError):
+        plan_temporal_holdout((1, 40), horizon, blocks)
+
+
+@pytest.mark.parametrize('operations', [('lagged', 'ridge'), ('smoothing', 'ar'), ('locf',)])
+def test_native_temporal_pipeline_fits_and_forecasts(operations):
+    data = create_data(np.arange(96, dtype=float), task='ts_forecasting', data_type='ts',
+                       ts_forecast_horizon=8, without_target=True)
+    train, test = next(DataSourceSplitter().build(data)())
+    builder = PipelineBuilder()
+    for operation in operations:
+        builder = builder.add_node(operation)
+    pipeline = builder.build()
+    pipeline.fit(train)
+    prediction = pipeline.predict(test).predict
+    assert prediction.numel() == 8
+    assert torch.isfinite(prediction).all()
+
+
+def test_legacy_bridge_rejects_multiple_series_and_ignores_future_fit_target():
+    data = create_data(np.arange(32, dtype=float), task='ts_forecasting', data_type='ts',
+                       ts_forecast_horizon=4)
+    legacy = legacy_temporal_input(data, fit_stage=True)
+    np.testing.assert_array_equal(legacy.target, legacy.features)
+    assert len(legacy.features) == 28
+    with pytest.raises(ValueError, match='one univariate'):
+        legacy_temporal_input(replace(data, idx=None, features=data.features.repeat(2, 1),
+                                      target=data.target.repeat(2, 1)), fit_stage=True)
+
+
+def test_lagged_forecaster_is_not_misclassified_as_lagged_transform():
+    advisor = PipelineChangeAdvisor(Task(TaskTypesEnum.ts_forecasting))
+    advisor.models.extend(['lagged_ridge_forecaster', 'mssa_forecaster'])
+    assert advisor.propose_change(OptNode('lagged_ridge_forecaster'), ['mssa_forecaster']) == {'mssa_forecaster'}
+    assert advisor.propose_change(OptNode('lagged'), ['mssa_forecaster', 'sparse_lagged']) == {'sparse_lagged'}
