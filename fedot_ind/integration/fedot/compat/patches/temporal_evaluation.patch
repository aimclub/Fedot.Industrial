@@ -0,0 +1,53 @@
+"""Explicit single-series boundary for legacy temporal implementations."""
+from dataclasses import replace
+
+import numpy as np
+import torch
+
+from fedot.core.data.input_data.data import InputData
+from fedot.core.data.tensor_data import TensorData
+from fedot.core.data.split.temporal import forecast_horizon
+from fedot.core.repository.dataset_types import DataTypesEnum
+from fedot.core.repository.tasks import Task, TaskTypesEnum, TsForecastingParams
+
+
+def legacy_temporal_input(data, *, fit_stage):
+    if not isinstance(data, TensorData):
+        return data
+    shape = tuple(data.features.shape)
+    if shape[0] != 1 or len(shape) not in (2, 3) or (len(shape) == 3 and shape[1] != 1):
+        raise ValueError('Legacy temporal operations support exactly one univariate series')
+    history = data.features.detach().cpu().numpy().reshape(-1).copy()
+    horizon = forecast_horizon(data)
+    idx = np.arange(len(history)) if fit_stage else np.arange(len(history), len(history) + horizon)
+    target = history.copy() if fit_stage else None
+    return InputData(features=history, target=target, idx=idx,
+                     task=Task(TaskTypesEnum.ts_forecasting, TsForecastingParams(horizon)),
+                     data_type=DataTypesEnum.ts)
+
+
+def tensor_temporal_output(output, source, *, is_transform):
+    if not isinstance(source, TensorData):
+        return output
+    values = np.asarray(output.predict)
+    is_series = output.data_type in (DataTypesEnum.ts, DataTypesEnum.multi_ts)
+    if is_series:
+        values = values.reshape(1, -1)
+        target = None if output.target is None else np.asarray(output.target).reshape(1, -1)
+        idx = source.idx
+        data_type = DataTypesEnum.ts
+    else:
+        if values.ndim == 1:
+            values = values.reshape(1, -1)
+        target = None if output.target is None else np.asarray(output.target)
+        if target is not None and target.ndim == 1:
+            target = target.reshape(1, -1)
+        idx = np.asarray(output.idx) if len(output.idx) == len(values) else np.arange(len(values))
+        data_type = DataTypesEnum.tabular
+    tensor = torch.as_tensor(values.copy(), device=source.device, dtype=source.features.dtype)
+    target = None if target is None else torch.as_tensor(target.copy(), device=source.device,
+                                                         dtype=source.features.dtype)
+    return replace(source, features=tensor, target=target, idx=idx,
+                   predict=None if is_transform else tensor.clone(), data_type=data_type,
+                   features_names=None, categorical_idx=[], numerical_idx=[], idx_mapping={},
+                   preparation_state=None, fingerprint=None, trace_uuid=None)
