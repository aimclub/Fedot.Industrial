@@ -0,0 +1,78 @@
+"""Checked single-series window boundary, separate from row-preserving transforms."""
+from dataclasses import replace
+
+import numpy as np
+import torch
+
+from fedot.core.operations.evaluation.temporal_bridge import legacy_temporal_input
+from fedot.core.data.split.temporal import forecast_horizon
+from fedot.core.repository.dataset_types import DataTypesEnum
+from fedot.core.repository.tasks import TaskTypesEnum
+from fedot.extensions.call_rules import invoke_once
+from fedot.extensions.contracts import ArrayBackend, ExtensionContractError, ExtensionError
+from fedot.extensions.runtime_contracts import TemporalTransformInput, TemporalTransformOutput
+
+
+def is_temporal_window_transform(spec, data):
+    return (data.task.task_type == TaskTypesEnum.ts_forecasting
+            and data.data_type in (DataTypesEnum.ts, DataTypesEnum.multi_ts)
+            and 'ts_to_table' in spec.capabilities.tags)
+
+
+def temporal_transform_request(data, backend, *, fit_stage):
+    legacy = legacy_temporal_input(data, fit_stage=fit_stage)
+    history = legacy.features.copy()
+    if backend is ArrayBackend.torch:
+        history = torch.as_tensor(history, device=data.device).clone()
+    return TemporalTransformInput(history, forecast_horizon(data), fit_stage, legacy.idx.copy())
+
+
+def _fail(message):
+    raise ExtensionContractError(ExtensionError('invalid_temporal_transform_output', message))
+
+
+def _checked_array(value, name):
+    if not isinstance(value, (np.ndarray, torch.Tensor)):
+        _fail(f'{name} must be a numpy array or torch tensor')
+    try:
+        finite = torch.isfinite(value).all().item() if isinstance(value, torch.Tensor) else np.isfinite(value).all()
+    except (TypeError, ValueError, RuntimeError):
+        _fail(f'{name} must be a finite numeric array')
+    if not finite:
+        _fail(f'{name} must be finite')
+    return value
+
+
+def apply_temporal_transform(spec, instance, data, *, fit_stage):
+    request = temporal_transform_request(data, spec.capabilities.backend, fit_stage=fit_stage)
+    method = getattr(instance, 'transform_temporal', None)
+    if not callable(method):
+        raise ExtensionContractError(ExtensionError(
+            'missing_runtime_method', 'A ts_to_table transform must implement transform_temporal'))
+    output = invoke_once(method, (((request,), {}),))
+    if not isinstance(output, TemporalTransformOutput):
+        _fail('A temporal transform must return TemporalTransformOutput')
+    features = _checked_array(output.features, 'features')
+    if features.ndim != 2 or any(size <= 0 for size in features.shape):
+        _fail('Window features must have non-empty (windows, features) axes')
+    if not fit_stage and features.shape[0] != 1:
+        _fail('Forecast inference must return exactly the latest window')
+    target = output.target
+    if fit_stage:
+        target = _checked_array(target, 'target')
+        if tuple(target.shape) != (features.shape[0], request.horizon):
+            _fail('Training targets must align with windows and the task horizon')
+    elif target is not None:
+        _fail('Inference windows must not contain a target')
+    if not isinstance(output.idx, (np.ndarray, torch.Tensor)) or output.idx.ndim != 1:
+        _fail('Window indices must be a one-dimensional array')
+    idx = output.idx.detach().cpu().numpy() if isinstance(output.idx, torch.Tensor) else output.idx
+    if len(idx) != len(features) or len(np.unique(idx)) != len(idx):
+        _fail('Each window must have one unique index')
+    tensor = torch.as_tensor(features, device=data.device, dtype=data.features.dtype).clone()
+    target = None if target is None else torch.as_tensor(
+        target, device=data.device, dtype=data.features.dtype).clone()
+    return replace(data, features=tensor, target=target, idx=idx.copy(), predict=None,
+                   data_type=DataTypesEnum.tabular, features_names=None,
+                   categorical_idx=[], numerical_idx=[], idx_mapping={},
+                   preparation_state=None, fingerprint=None, trace_uuid=None)
